generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id           String   @id @default(cuid())
  code         String   @unique
  fixtureId    Int
  leagueId     Int      // API-Football competition id (World Cup, PL, ...) — NOT the social League below
  homeTeamId   Int
  awayTeamId   Int
  homeTeamName String
  awayTeamName String
  homeTeamLogo String?
  awayTeamLogo String?
  venue        String?
  matchDate    DateTime
  createdAt    DateTime @default(now())
  players      Player[]

  // Optional link to a social League (umbrella over many rooms). Null for normal/outsider rooms.
  leagueGroupId String?
  leagueGroup   League? @relation(fields: [leagueGroupId], references: [id], onDelete: SetNull)

  @@index([fixtureId])
  @@index([leagueGroupId])
}

model Player {
  id           String   @id @default(cuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  displayName  String
  sessionToken String   @unique
  isCreator    Boolean  @default(false)
  totalPoints  Int      @default(0)
  captainSlot  Int      @default(0)
  picks        Pick[]
  createdAt    DateTime @default(now())

  // Optional link to a persistent league identity (set when an auto-recognised league member joins)
  leagueMemberId String?
  leagueMember   LeagueMember? @relation(fields: [leagueMemberId], references: [id], onDelete: SetNull)

  @@unique([roomId, displayName])
  @@index([roomId])
  @@index([sessionToken])
  @@index([leagueMemberId])
}

// A social "league": a season-long umbrella over many game rooms within one competition.
model League {
  id            String   @id @default(cuid())
  code          String   @unique          // shareable league code
  name          String
  competitionId Int                        // API-Football competition id (matches LEAGUES[].id)
  season        Int                        // matches LEAGUES[].season
  createdAt     DateTime @default(now())
  members       LeagueMember[]
  rooms         Room[]

  @@index([competitionId])
}

// A persistent identity within a league. The memberToken lives in the livev_leagues cookie,
// letting the same person be recognised across every game room created under the league.
model LeagueMember {
  id          String   @id @default(cuid())
  leagueId    String
  league      League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  displayName String
  memberToken String   @unique
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())
  players     Player[]

  @@unique([leagueId, displayName])
  @@index([leagueId])
  @@index([memberToken])
}

model Pick {
  id                 String @id @default(cuid())
  playerId           String
  player             Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  footballPlayerId   Int
  footballPlayerName String
  teamId             Int
  position           String
  slotIndex          Int
  points             Int    @default(0)
  pointsBreakdown    Json?

  @@unique([playerId, slotIndex])
  @@index([playerId])
  @@index([footballPlayerId])
}

model MatchCache {
  id          String   @id @default(cuid())
  fixtureId   Int      @unique
  status      String   @default("NS")
  homeScore   Int?
  awayScore   Int?
  minute      Int?
  events      Json?
  playerStats Json?
  updatedAt   DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String   // page_view, game_created, game_joined, team_saved, share_clicked, help_opened
  page      String?  // URL path e.g. "/", "/room/ABC123", "/room/ABC123/pick"
  metadata  Json?    // Optional extra context
  sessionId String   // Anonymous browser session ID (not tied to a player account)
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
  @@index([sessionId])
}
